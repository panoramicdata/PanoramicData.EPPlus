<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageProjectUrl>https://github.com/rimland/EPPlus</PackageProjectUrl>
    <Authors>Rimland, Panoramic Data Limited</Authors>
    <Company></Company>
    <Product>EPPlus Free Edition</Product>
    <Title>Panoramic Data's EPPlus Free Edition</Title>
    <Description>PanoramicData.EPPlus is an unofficial EPPlus library, targeting .NET 11 and above.</Description>
    <AssemblyName>PanoramicData.EPPlus</AssemblyName>
    <RootNamespace>OfficeOpenXml</RootNamespace>
    <RepositoryUrl>https://github.com/panoramicdata/PanoramicData.EPPlus</RepositoryUrl>
    <PackageTags>EPPlus Excel Spreadsheet xlsx ooxml</PackageTags>
    <Copyright>Rimland 2020, Panoramic Data Limited 2026</Copyright>
    <PackageReleaseNotes>
			# Panoramic Data's EPPlus Free Edition
			# LGPL License continue
			11.0 - BREAKING. Full details: https://github.com/panoramicdata/PanoramicData.EPPlus/blob/main/CHANGELOG.md
			Targets .NET 11 (net11.0).
			System.Drawing.Common (GDI+) is no longer used: the Image and Font based members are replaced by byte[] and Stream overloads, and AutoFitColumns measures text with SkiaSharp.
			The bundled DotNetZip code is removed and packages are read and written with System.IO.Compression. The 22 public types in OfficeOpenXml.Packaging.DotNetZip and OfficeOpenXml.Packaging.DotNetZip.Zlib are gone; use System.IO.Compression instead. Zip64 is still used only when a workbook needs it.
			Some methods in Drawing, Style and ConditionalFormatting now throw InvalidOperationException or ArgumentException instead of System.Exception, with the same messages.
			double to decimal conversions keep the .NET 10 rounding to 15 significant digits on .NET 11.
		</PackageReleaseNotes>
    <SignAssembly>False</SignAssembly>
    <AssemblyOriginatorKeyFile>OpenOfficeXml.Rimland.snk</AssemblyOriginatorKeyFile>
    <NeutralLanguage />
    <!-- Vendored EPPlus source was never fully annotated: keep the annotations, drop the nullable warnings. -->
    <Nullable>annotations</Nullable>
    <!-- Same reason: about 2,200 vendored public members have no XML documentation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>True</IncludeSymbols>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>PanoramicData.EPPlus</PackageId>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='AnyCPU'">
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\EPPlusFree.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="lgpl-3.0.txt">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="icon.jpg" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
</Project>