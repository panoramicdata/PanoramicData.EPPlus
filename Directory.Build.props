<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NuGetAuditMode>All</NuGetAuditMode>
    <!-- This repository is a fork of a large third-party codebase (EPPlus). Nullable annotations
         and warnings-as-errors were switched on across it by an automated governance commit
         (1a8baa10), which left the branch unbuildable with 5,618 errors, almost all nullability.
         Annotating the vendored source is a deliberate project of its own, not a precondition for
         shipping a fix, so warnings stay warnings here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Copyright>Copyright © Panoramic Data Limited</Copyright>
    <Authors>Panoramic Data Limited</Authors>
    <Company>Panoramic Data Limited</Company>
  </PropertyGroup>
</Project>