<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- This sample is written against the older ASP.NET Core hosting API. Implicit usings pull in
         both Microsoft.AspNetCore.Hosting and Microsoft.Extensions.Hosting, which makes
         IHostingEnvironment ambiguous (CS0104). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.DotNet.Watcher.Tools" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PanoramicData.EPPlus\PanoramicData.EPPlus.csproj" />
  </ItemGroup>
</Project>